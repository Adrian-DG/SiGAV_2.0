{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Archivos de las evidencias. Proveedor: "Local" (carpeta del servidor, para desarrollo).
  // Pendiente de definir el de producción: Azure Blob Storage o Cloudinary.
  "Almacenamiento": {
    "Proveedor": "Local",
    "Local": {
      "Ruta": "App_Data/archivos"
    }
  },
  "Seed": {
    "ApplyMigrations": false,
    "Enabled": true,
    "DemoData": false,
    "Admin": {
      "UserName": "admin",
      "Password": ""
    }
  },
  "Jwt": {
    "Issuer": "sigav-api",
    "SecretKey": "",
    "ClockSkewSeconds": 60,
    "Web": {
      "Audience": "sigav-web",
      "ExpirationHours": 8
    },
    "Movil": {
      "Audience": "sigav-movil",
      "ExpirationHours": 12
    }
  }
}
